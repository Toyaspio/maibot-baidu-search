{
  "manifest_version": 2,
  "id": "toyaspio.maibot-baidu-search",
  "name": "MaiSearch 百度搜索",
  "version": "0.1.0",
  "description": "通过百度千帆官方 API 搜索公开网页，支持手动命令和默认关闭的 LLM Tool。",
  "author": {"name": "Toyaspio", "url": "https://github.com/Toyaspio"},
  "license": "MIT",
  "urls": {"repository": "https://github.com/Toyaspio/maibot-baidu-search"},
  "host_application": {"min_version": "1.3.5", "max_version": "1.3.5"},
  "sdk": {"min_version": "2.10.0", "max_version": "2.10.0"},
  "capabilities": ["send.text"],
  "dependencies": [{"type": "python_package", "name": "httpx", "version_spec": ">=0.28.1,<0.29"}],
  "i18n": {"default_locale": "zh-CN"},
  "changelog": "CHANGELOG.md"
}
